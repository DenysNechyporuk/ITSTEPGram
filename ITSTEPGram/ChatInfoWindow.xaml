<Window x:Class="ITSTEPGram.ChatInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Інформація про чат" Height="560" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource AvatarBrush}" HorizontalAlignment="Center">
                <TextBlock x:Name="AvatarText" Foreground="White" FontSize="28" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="ChatNameText" Style="{StaticResource TitleText}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock x:Name="InfoText" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Учасники" Style="{StaticResource FieldLabel}"/>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="0,6">
            <ListBox x:Name="MembersList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource AvatarBrush}">
                                <TextBlock Text="{Binding Letter}" Foreground="White" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Login}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Role}" FontSize="12"
                                       Foreground="{StaticResource AccentLightBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3">
            <Grid x:Name="AddPanel" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AddLoginInput" MaxLength="50"/>
                <TextBlock x:Name="AddHint" Text="Email нового учасника" IsHitTestVisible="False"
                           Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button Grid.Column="1" Content="Додати" Margin="8,0,0,0" Click="AddButton_Click"/>
            </Grid>
            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}"/>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Button Content="Покинути чат" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Click="LeaveButton_Click"/>
            <Button Content="Закрити" HorizontalAlignment="Right" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
