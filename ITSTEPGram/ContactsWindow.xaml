<Window x:Class="ITSTEPGram.ContactsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Контакти" Height="660" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Контакти" Style="{StaticResource TitleText}"/>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchInput" KeyDown="SearchInput_KeyDown" TextChanged="SearchInput_TextChanged"/>
            <TextBlock x:Name="SearchHint" Text="Ім'я або email" IsHitTestVisible="False"
                       Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            <Button Grid.Column="1" Content="Знайти" Margin="8,0,0,0" Click="SearchButton_Click"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="Результати пошуку" Style="{StaticResource FieldLabel}"/>
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="0,4">
            <ListBox x:Name="ResultsList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource AvatarBrush}">
                                <TextBlock Text="{Binding Letter}" Foreground="White" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Login}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Button x:Name="AddButton" Grid.Column="2" Content="Додати" Padding="12,6" FontSize="13"
                                    Tag="{Binding Id}" Click="AddButton_Click"/>
                        </Grid>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsContact}" Value="True">
                                <Setter TargetName="AddButton" Property="Content" Value="У контактах"/>
                                <Setter TargetName="AddButton" Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RequestStatus}" Value="PendingOutgoing">
                                <Setter TargetName="AddButton" Property="Content" Value="Очікує"/>
                                <Setter TargetName="AddButton" Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RequestStatus}" Value="PendingIncoming">
                                <Setter TargetName="AddButton" Property="Content" Value="Є заявка"/>
                                <Setter TargetName="AddButton" Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="4" Text="Заявки" Style="{StaticResource FieldLabel}"/>
        <Border Grid.Row="5" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="0,4">
            <Grid>
                <ListBox x:Name="RequestsList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource AvatarBrush}">
                                    <TextBlock Text="{Binding Letter}" Foreground="White" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Login}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="✓" Padding="10,6" FontSize="13"
                                        Tag="{Binding RequestId}" Click="AcceptButton_Click"/>
                                <Button Grid.Column="3" Content="✕" Style="{StaticResource IconButton}" FontSize="14"
                                        Margin="4,0,0,0" Tag="{Binding RequestId}" Click="RejectButton_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="NoRequestsText" Text="Нових заявок немає" Visibility="Collapsed"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="6" Text="Мої контакти" Style="{StaticResource FieldLabel}"/>
        <Border Grid.Row="7" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="0,4">
            <Grid>
                <ListBox x:Name="ContactsList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource AvatarBrush}">
                                    <TextBlock Text="{Binding Letter}" Foreground="White" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource AccentLightBrush}"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="Написати" Padding="12,6" FontSize="13"
                                        Tag="{Binding Login}" Click="WriteButton_Click"/>
                                <Button Grid.Column="3" Content="✕" Style="{StaticResource IconButton}" FontSize="14" Margin="4,0,0,0"
                                        ToolTip="Видалити з контактів" Tag="{Binding Id}" Click="RemoveButton_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="NoContactsText" Text="Контактів поки немає" Visibility="Collapsed"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Button Grid.Row="8" Content="Закрити" HorizontalAlignment="Right" Margin="0,14,0,0" Click="CloseButton_Click"/>
    </Grid>
</Window>