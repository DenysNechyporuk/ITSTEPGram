<Window x:Class="ITSTEPGram.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ITSTEPGram" Height="680" Width="1050" MinHeight="450" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14"
        Closed="Window_Closed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="10,10,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="☰" Style="{StaticResource IconButton}" ToolTip="Налаштування" Click="SettingsButton_Click"/>
                    <Button Grid.Column="1" Content="👥" Style="{StaticResource IconButton}" ToolTip="Контакти" Click="ContactsButton_Click"/>
                    <Grid Grid.Column="2" Margin="8,0,0,0">
                        <TextBox x:Name="SearchBox" Padding="12,6" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchHint" Text="Пошук" IsHitTestVisible="False"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </Grid>
                </Grid>

                <ListBox x:Name="ChatsList" Grid.Row="1" SelectionChanged="ChatsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource AvatarBrush}">
                                    <TextBlock Text="{Binding Letter}" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding LastMessage}" Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="13" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding LastTime}" Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="NoChatsText" Grid.Row="1" Visibility="Collapsed"
                           Text="Чатів поки немає.&#x0a;Створіть новий чат кнопкою нижче."
                           TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>

                <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✎  Новий чат" Click="NewChatButton_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource ChatBackgroundBrush}">
            <Border x:Name="EmptyPanel" Background="{StaticResource HeaderBrush}" CornerRadius="14" Padding="16,8"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Оберіть чат, щоб почати спілкування" Foreground="{StaticResource SecondaryTextBrush}"/>
            </Border>

            <Grid x:Name="ChatPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AvatarBrush}">
                            <TextBlock x:Name="ChatAvatarText" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ChatTitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ChatInfoText" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="ⓘ" Style="{StaticResource IconButton}" ToolTip="Інформація про чат" Click="ChatInfoButton_Click"/>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,8">
                    <ItemsControl x:Name="MessagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Bubble" Background="{StaticResource OtherBubbleBrush}" CornerRadius="14"
                                        Padding="12,7" Margin="14,3" MaxWidth="460" HorizontalAlignment="Left">
                                    <StackPanel>
                                        <TextBlock x:Name="SenderText" Text="{Binding SenderName}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Right" Margin="12,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                        <Setter TargetName="Bubble" Property="Background" Value="{StaticResource MyBubbleBrush}"/>
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SenderName}" Value="">
                                        <Setter TargetName="SenderText" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MessageInput" MaxLength="50" KeyDown="MessageInput_KeyDown" TextChanged="MessageInput_TextChanged"/>
                        <TextBlock x:Name="MessageHint" Text="Повідомлення..." IsHitTestVisible="False"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <Button Grid.Column="1" Content="➤" Width="46" Height="40" Padding="0" Margin="8,0,0,0"
                                ToolTip="Надіслати" Click="SendButton_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
