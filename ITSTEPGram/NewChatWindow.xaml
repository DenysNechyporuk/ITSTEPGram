<Window x:Class="ITSTEPGram.NewChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новий чат" Height="460" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Новий чат" Style="{StaticResource TitleText}"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,4">
                <RadioButton x:Name="PrivateRadio" Content="Особистий" IsChecked="True" Checked="TypeRadio_Checked"/>
                <RadioButton x:Name="GroupRadio" Content="Група" Margin="24,0,0,0" Checked="TypeRadio_Checked"/>
            </StackPanel>

            <StackPanel x:Name="PrivatePanel">
                <TextBlock Text="Email користувача" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="LoginInput" MaxLength="50"/>
            </StackPanel>

            <StackPanel x:Name="GroupPanel" Visibility="Collapsed">
                <TextBlock Text="Назва групи" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="GroupNameInput" MaxLength="50"/>
                <TextBlock Text="Email учасників (через кому)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="MembersInput"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Скасувати" Style="{StaticResource LinkButton}" Click="CancelButton_Click"/>
            <Button Content="Створити" Margin="10,0,0,0" Click="CreateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
